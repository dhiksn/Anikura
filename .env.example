# =============================================
# ANIKURA - Environment Configuration
# =============================================
# Copy this file:
#   Backend  → .env         (at repo root, used by Express)
#   Frontend → client/.env.local  (used by Next.js)

# ─────────────────────────────────────────────
# BACKEND (Express — anikuraz-api.vercel.app)
# Set these in Vercel → anikuraz-api → Settings → Environment Variables
# ─────────────────────────────────────────────

# Cloudflare Worker proxy URL (optional but recommended for Vercel deployment)
# Fetch animasu.love HTML through CF Worker to avoid Vercel IP blocks
# Set to your Worker URL: https://anikura-proxy.YOUR-SUBDOMAIN.workers.dev
CF_PROXY_URL=

# Target website to scrape
BASE_URL=https://animasu.love

# Author tag injected into every JSON response
AUTHOR=dhiksn

# Allowed CORS origins — comma-separated, or * for all
# Production: set to your frontend domain
CORS_ORIGIN=https://anikuraz.vercel.app

# Server port (local dev only — Vercel ignores this)
PORT=3000
NODE_ENV=production

# HTTP client settings
REQUEST_TIMEOUT=15000
MAX_RETRIES=3
RETRY_DELAY=1000

# In-memory cache (not used in serverless — kept for local dev)
CACHE_TTL=300
CACHE_MAX_KEYS=500

# ─────────────────────────────────────────────
# FRONTEND (Next.js — anikuraz.vercel.app)
# Set these in Vercel → anikuraz → Settings → Environment Variables
# ─────────────────────────────────────────────

# Backend API base URL — server-side only, never bundled to browser
# Used by backend-client.ts on the server
API_URL=https://anikuraz-api.vercel.app

# Source website base URL
NEXT_PUBLIC_SOURCE_BASE_URL=https://animasu.love

# Optional: override API URL in browser bundle (dev only)
# Leave empty in production — server uses API_URL instead
NEXT_PUBLIC_API_URL=

# ─────────────────────────────────────────────
# LOCAL DEVELOPMENT (both running together)
# ─────────────────────────────────────────────
# Backend:  npm run dev         → http://localhost:3000
# Frontend: cd client && npm run dev → http://localhost:3001
#
# For local dev, create client/.env.local with:
#   API_URL=http://localhost:3000
#   NEXT_PUBLIC_API_URL=http://localhost:3000
#   NEXT_PUBLIC_SOURCE_BASE_URL=https://animasu.love
