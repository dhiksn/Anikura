# =============================================
# ANIKURA - Environment Configuration
# =============================================
# Salin file ini menjadi .env di root (untuk Express legacy)
# dan client/.env.local (untuk Next.js / Vercel)

# ─── Target Website ────────────────────────────────────────────────────────────
BASE_URL=https://animasu.love
# Dipakai oleh Next.js API routes (harus NEXT_PUBLIC_ agar terbaca di client)
NEXT_PUBLIC_SOURCE_BASE_URL=https://animasu.love

# ─── Author tag (muncul di setiap response JSON) ───────────────────────────────
AUTHOR=dhiksn

# ─── Next.js API base URL ──────────────────────────────────────────────────────
# Biarkan kosong untuk pakai relative /api (cocok untuk Vercel, semua-dalam-satu).
# Isi jika backend Express masih dijalankan terpisah, mis. http://localhost:3000/api
NEXT_PUBLIC_API_URL=

# ─── Vercel → Cloudflare Worker HTML relay ─────────────────────────────────────
# Wajib di Vercel: IP datacenter Vercel di-block (403) oleh situs sumber.
# Biarkan kosong di lokal (Next scrape langsung).
# Isi URL Worker, tanpa trailing slash. Contoh:
#   https://anikura-fetch.akun.workers.dev
# SCRAPER_API_URL=
# Secret yang sama di `npx wrangler secret put SCRAPER_SECRET` dan di Vercel.
# SCRAPER_SECRET=ganti-dengan-string-acak

# ─── Express-only settings (tidak dipakai di Next.js/Vercel) ───────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
REQUEST_TIMEOUT=15000
CACHE_TTL=300
CACHE_MAX_KEYS=500
MAX_RETRIES=3
RETRY_DELAY=1000
# Harus sama dengan SCRAPER_SECRET di Vercel. Generate string acak yang kuat.
SCRAPER_SECRET=
