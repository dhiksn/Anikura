# =============================================
# ANIKURA - Environment Configuration
# =============================================
# Salin file ini menjadi .env di root (untuk Express backend)
# dan client/.env.local (untuk Next.js / Vercel)

# ─── Backend Configuration (src/.env) ───────────────────────────────────────────
# Untuk backend, salin ke src/.env
BASE_URL=https://animasu.love
AUTHOR=dhiksn
PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://anikuraz.vercel.app

# ─── Frontend Configuration (client/.env.local) ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOURCE_BASE_URL=https://animasu.love
AUTHOR=dhiksn
