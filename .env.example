# =============================================
# ANIKURA API - Environment Configuration
# =============================================
# Salin file ini menjadi .env dan sesuaikan nilainya

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Target Website ---
BASE_URL=https://animasu.love

# --- CORS ---
# Gunakan * untuk mengizinkan semua origin, atau tentukan domain spesifik
# Contoh: https://myapp.com,https://myapp2.com
CORS_ORIGIN=*

# --- HTTP Client ---
# Timeout request dalam milidetik
REQUEST_TIMEOUT=15000

# --- Cache ---
# Durasi cache dalam detik
CACHE_TTL=300
# Maksimal item dalam cache
CACHE_MAX_KEYS=500

# --- Rate Limiting ---
# Maksimal retry jika request gagal
MAX_RETRIES=3
# Delay antar retry dalam milidetik
RETRY_DELAY=1000

# --- Author ---
AUTHOR=dhiksn
