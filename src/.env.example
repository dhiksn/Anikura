# =============================================
# ANIKURA BACKEND - Environment Configuration
# =============================================

# ─── Target Website ────────────────────────────────────────────────────────────
BASE_URL=https://animasu.love

# ─── Author tag (muncul di setiap response JSON) ───────────────────────────────
AUTHOR=dhiksn

# ─── Server Configuration ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://anikuraz.vercel.app

# ─── Performance Settings ────────────────────────────────────────────────────────
REQUEST_TIMEOUT=15000
CACHE_TTL=300
CACHE_MAX_KEYS=500
MAX_RETRIES=3
RETRY_DELAY=1000
