# =============================================
# ANIKURA Frontend — Next.js Environment
# =============================================
# Copy to client/.env.local for local development
# Set in Vercel → anikuraz → Settings → Environment Variables for production

# Backend API base URL (server-side only — NOT bundled to browser)
# Production: https://anikuraz-api.vercel.app
# Local dev:  http://localhost:3000
API_URL=http://localhost:3000

# Source website (animasu.love)
NEXT_PUBLIC_SOURCE_BASE_URL=https://animasu.love

# Optional browser-side API URL override (for local dev or debugging)
# Leave empty in production
NEXT_PUBLIC_API_URL=http://localhost:3000
